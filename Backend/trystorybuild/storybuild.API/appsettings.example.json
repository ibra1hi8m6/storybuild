{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.5-flash",
    "VisionModel": "gemini-2.0-flash",
    "AudioModel": "gemini-2.0-flash"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "Cloudflare": {
    "AccountId": "YOUR_CF_ACCOUNT_ID",
    "ApiToken": "YOUR_CF_API_TOKEN",
    "OutputDirectory": "wwwroot/images",
    "NumSteps": 8,
    "Width": 512,
    "Height": 512
  },
  "Writing": {
    "UploadsDirectory": "wwwroot/uploads"
  },
  "PdfImport": {
    "PdfUploadDirectory": "Uploads/Pdf",
    "ImagesOutputDirectory": "wwwroot/images/lessons"
  },
  "PdfLibrary": {
    "PdfStorageDirectory": "Uploads/PdfLibrary",
    "PageImagesDirectory": "wwwroot/uploads/pdf-pages",
    "PageImagesBaseUrl": "/uploads/pdf-pages"
  },
  "Rag": {
    "ChromaEndpoint": "https://api.trychroma.com:8000",
    "ChromaApiKey": "YOUR_CHROMA_API_KEY",
    "CollectionName": "arabic-edu",
    "ChromaTenant": "default_tenant",
    "ChromaDatabase": "default_database",
    "DocumentsDirectory": "wwwroot/rag-docs",
    "ChunkSize": 400,
    "ChunkOverlap": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "lughati-api",
    "Audience": "lughati-client"
  },
  "AllowedHosts": "*",
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "YOUR_GMAIL_ADDRESS",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "FromAddress": "YOUR_GMAIL_ADDRESS",
    "FromName": "منصة لغتي"
  }
}
